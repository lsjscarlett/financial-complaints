# Template only -- no real values. Copy to .env and fill in (.env is gitignored).
# Or set them directly in PowerShell:
#   $env:OPENAI_API_KEY = "sk-..."

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Optional: raw CFPB export for feature_engineering.py (default dataset/complaints.csv)
CFPB_COMPLAINTS_CSV=

# Optional: input for generate_llm_responses.py (default dataset/complaints_10k.csv)
LLM_INPUT_CSV=
# Rows to process: a number, or "all" (default 10). Each row is 9 paid API calls.
LLM_SAMPLE_ROWS=
# Parallel calls per provider (default 4)
LLM_CONCURRENCY=
